# Provedor de LLM: "groq" (padrão, recomendado) ou "ollama" (100% local)
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys — tier gratuito, sem cartão) ---
GROQ_API_KEY=coloque_sua_chave_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (alternativa local, requer `ollama serve` rodando na máquina) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- RAG ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
